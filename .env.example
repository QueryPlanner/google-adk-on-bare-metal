# Core Identity
AGENT_NAME=local-agent

# Model Configuration
# Use provider/model-name for OpenRouter (e.g., openrouter/google/gemini-2.0-flash-001)
ROOT_AGENT_MODEL=google/gemini-2.0-flash-001

# API Keys
OPENROUTER_API_KEY=your-openrouter-key-here
GITHUB_TOKEN=your-github-token-here

# Database Configuration
# Standard and SQLAlchemy TLS options are normalized for their asyncpg consumer
DATABASE_URL=postgresql://user:pass@host:port/dbname?ssl=require
# Bound database startup waits and individual connection/query attempts (seconds)
DB_READY_TIMEOUT=60
DB_READY_RETRY_INTERVAL=1
DB_READY_ATTEMPT_TIMEOUT=5
# Bound each recurring HTTP PostgreSQL readiness probe below its 3s client
DB_READINESS_PROBE_TIMEOUT=2
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Server Configuration
LOG_LEVEL=INFO
# Bare-metal process bind. Compose overrides HOST inside the container.
HOST=127.0.0.1
PORT=8080
# Compose publishes to loopback unless this host-side address is overridden.
AGENT_PUBLISH_HOST=127.0.0.1

# Feature Flags
SERVE_WEB_INTERFACE=false
RELOAD_AGENTS=false
# Privacy-sensitive opt-in. False elides structured prompt/response and tool
# argument/result fields only. Exceptions, descriptions, and IDs may export.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# ---------------------------------------------------------------------------
# Optional Remote Trace Export (Choose At Most One Complete Mode)
# ---------------------------------------------------------------------------

# Option 1: Langfuse. Set both keys; the base URL is optional.
# The server derives the HTTP/protobuf /api/public/otel/v1/traces endpoint and
# the Basic auth plus x-langfuse-ingestion-version=4 trace headers.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Option 2: Explicit trace-only OTLP/HTTP. Do not set LANGFUSE_* with this mode.
# The endpoint is the complete signal URL and must end once in /v1/traces.
# Remote collectors require HTTPS; plaintext HTTP is accepted only on loopback.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example.com/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20replace-me
#
# Optional for either complete mode. The effective default is 2 seconds; a
# custom value must be finite, greater than 0, and at most 2. Timeout alone does
# not enable remote export.
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=2
#
# These four are the only accepted OTEL_EXPORTER_OTLP_* names. Legacy generic,
# metric-specific, log-specific, and other exporter settings are rejected.

# ---------------------------------------------------------------------------
# Mem0 Memory Integration (Optional)
# ---------------------------------------------------------------------------
# Enable persistent memory across conversations using mem0ai.
# Self-hosted by default - no mem0 platform API key or separate Qdrant
# service required for local development.
#
# Quick Start:
#   Just set OPENROUTER_API_KEY above - mem0 will work automatically with:
#   - Embedded on-disk Qdrant (data stored in ./data/qdrant)
#   - Local FastEmbed embeddings (model: BAAI/bge-small-en-v1.5)
#   - Your OpenRouter API key for LLM operations
#
# LLM Configuration (uses OPENROUTER_API_KEY by default)
# MEM0_LLM_MODEL=openrouter/google/gemini-2.0-flash-001
# MEM0_LLM_API_KEY=  # Optional override; defaults to OPENROUTER_API_KEY
# MEM0_LLM_TEMPERATURE=0.1
# MEM0_LLM_MAX_TOKENS=1000
#
# Embedder Configuration (local, no API key needed)
# MEM0_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# MEM0_EMBEDDER_DIMS=384  # Optional override for unsupported/custom models
#
# Memory Configuration
# MEM0_USER_ID=default
# MEM0_COLLECTION_NAME=agent_memories
# MEM0_SEARCH_LIMIT=5
#
# Vector Store - Embedded Mode (default)
# Memories persist on disk at this path. Directory is created automatically.
# MEM0_QDRANT_PATH=./data/qdrant
#
# Vector Store - Remote Server Mode (optional)
# Uncomment both to connect to an external Qdrant server instead of embedded mode:
# MEM0_QDRANT_HOST=localhost
# MEM0_QDRANT_PORT=6333
