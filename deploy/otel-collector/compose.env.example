# Paths are resolved by Docker Compose on the VM host.
AGENT_NAME=local-agent
# Replace this example with the numeric GID of the dedicated otel-gateway group.
OTEL_GATEWAY_SECRET_GID=10002
OTEL_GATEWAY_AGENT_ENV_FILE=.env.trace-agent
OTEL_GATEWAY_COLLECTOR_ENV_FILE=.env.trace-collector
OTEL_GATEWAY_CA_FILE=secrets/otel-gateway/ca.pem
OTEL_GATEWAY_SERVER_CERTIFICATE_FILE=secrets/otel-gateway/server.pem
OTEL_GATEWAY_SERVER_KEY_FILE=secrets/otel-gateway/server.key
OTEL_GATEWAY_RECEIVER_TOKEN_FILE=secrets/otel-gateway/receiver.token
OTEL_GATEWAY_LANGFUSE_TOKEN_FILE=secrets/otel-gateway/langfuse-basic.token
OTEL_GATEWAY_HEALTH_PORT=13133
OTEL_GATEWAY_METRICS_PORT=8888
